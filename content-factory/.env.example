# Скопируй в .env и заполни. .env в .gitignore, сюда реальные ключи не коммитим.

# RapidAPI: подписки на real-time-instagram-scraper-api1 и social-download-all-in-one
# https://rapidapi.com/allapiservice/api/real-time-instagram-scraper-api1
# https://rapidapi.com/nguyenmanhict-MuTUtGWD7K/api/social-download-all-in-one
RAPIDAPI_KEY=

# Higgsfield — уже подключён как MCP-сервер в сессии агента, отдельный ключ здесь не нужен.
# Оставлено на случай прямых REST-вызовов вне MCP.
HIGGSFIELD_API_KEY=

# Сервисный аккаунт Google Cloud с доступом на чтение/запись к таблице
# [Контент-завод] Poddubotsky (расшарить таблицу на его e-mail)
GOOGLE_SA_JSON=./secrets/google-service-account.json
GOOGLE_SHEET_ID=1Ty4fexcik22I35B19iy775ydypks2l1JTO7hzgaH5DI

# ChatPlace — кабинет ChatPlace, раздел API/интеграции
CHATPLACE_TOKEN=

# Telegram-бот для приёмки в канал (@BotFather)
TELEGRAM_BOT_TOKEN=
TG_CHAT_ID=

# Деплой гайдов (совпадает с deploy.sh в корне репозитория)
DEPLOY_SERVER=
DEPLOY_DOMAIN=

# Опционально: локальный ASR для расшифровки (whisper-cli и т.п.)
WHISPER_BIN=whisper
